{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "*.rules", "tools/**", "README.md", "**/.*"],
    "headers": [
      {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|html|webmanifest)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules"},
  "storage": {"rules": "storage.rules"}
}
